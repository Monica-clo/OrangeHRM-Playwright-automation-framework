# The framework reads OS environment variables (set them in your shell or as CI secrets).
ORANGEHRM_BASE_URL=https://opensource-demo.orangehrmlive.com
ORANGEHRM_USERNAME=Admin
ORANGEHRM_PASSWORD=admin123
DATA_SOURCE=json
BROWSER=chromium,firefox
CHROMIUM_CHANNEL=chrome
FIREFOX_CHANNEL=moz-firefox
RECORD_VIDEO=true
VIDEO_CAPTIONS=true
SLOW_MO_MS=0
TRACING=retain-on-failure
CLEANUP_CREATED_EMPLOYEES=true

# ReqRes - only POST/PUT/PATCH/DELETE /api/users and GET /api/users?delay=2 are used
REQRES_BASE_URL=https://reqres.in
REQRES_API_KEY=
REQRES_SKIP_ON_QUOTA=false
